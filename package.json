{
  "name": "software-factory",
  "private": true,
  "version": "4.7.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "verify": "npm run lint && npm test && npm run build && bash scripts/verify-layer4.sh",
    "verify:layer1": "npm run build && bash scripts/verify-layer1.sh",
    "verify:layer2": "npm run build && bash scripts/verify-layer2.sh",
    "verify:layer3": "npm run build && bash scripts/verify-layer3.sh",
    "verify:layer4": "npm run build && bash scripts/verify-layer4.sh",
    "verify:release": "bash scripts/verify-release.sh"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
