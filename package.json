{
  "name": "software-factory",
  "private": true,
  "version": "4.8.0",
  "type": "module",
  "scripts": {
    "appwrite:check": "tsx scripts/check-appwrite.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "dashboard": "node scripts/generate-dashboard.mjs",
    "dashboard:write": "node scripts/generate-dashboard.mjs --write",
    "dev": "tsx server.ts",
    "kb:self-test": "node scripts/kb-mcp-server.mjs --self-test",
    "kb:serve": "node scripts/kb-mcp-server.mjs",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "render:egress": "bash scripts/render-egress-policy.sh",
    "start": "node dist/server.cjs",
    "test": "tsx --test --import ./test/setup-isolate-env.ts --test-concurrency=1 test/**/*.test.ts",
    "verify": "npm run lint && npm test && npm run build && bash scripts/verify-layer4.sh",
    "verify:docs": "bash scripts/verify-docs.sh",
    "verify:image": "bash scripts/verify-image.sh",
    "verify:integrations": "bash scripts/verify-integrations.sh",
    "verify:secrets": "bash scripts/verify-no-secrets.sh",
    "verify:layer1": "npm run build && bash scripts/verify-layer1.sh",
    "verify:layer2": "npm run build && bash scripts/verify-layer2.sh",
    "verify:layer3": "npm run build && bash scripts/verify-layer3.sh",
    "verify:layer4": "npm run build && bash scripts/verify-layer4.sh",
    "verify:release": "npm run verify:secrets && npm run verify:storage && npm run verify:scopes && bash scripts/verify-release.sh",
    "appwrite:provision": "tsx scripts/provision-appwrite.ts",
    "appwrite:e2e": "tsx scripts/e2e-tenant-roundtrip.ts",
    "verify:secrets:control": "bash scripts/verify-secret-gate-control.sh",
    "verify:storage": "bash scripts/verify-storage-backend.sh",
    "verify:storage:live": "bash scripts/verify-storage-backend.sh --require-appwrite",
    "verify:scopes": "bash scripts/verify-appwrite-scopes.sh"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "node-appwrite": "^29.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
