# GEMINI_API_KEY: Required for Gemini AI API calls.
# Provide this through the deployment secret manager or local environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Appwrite Core Backend Configuration
APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="b2b_software_factory_proj"
APPWRITE_API_KEY="standard_appwrite_api_key_secret"
APPWRITE_DATABASE_ID="b2b_software_factory"

# Founder runtime controls
# Required in production. Use a long random value and store it outside the repository.
FACTORY_API_KEY="replace-with-a-long-random-secret"
# Local-only development convenience; never enable this in production.
ALLOW_INSECURE_LOCAL="true"
FACTORY_DATA_DIR=".data"
REQUEST_BODY_LIMIT="1mb"
