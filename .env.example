# Software Factory — environment configuration
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored. The service loads it automatically at startup.
#
# FAIL-CLOSED BEHAVIOUR: in production the process refuses to start (exit code 78)
# when FACTORY_API_KEY is missing, too short, or when ALLOW_INSECURE_LOCAL=true.

# ─── Core ────────────────────────────────────────────────────────────────────
# Runtime mode: production | development | test
NODE_ENV=development

# HTTP port.
PORT=3000

# Maximum accepted JSON request body.
REQUEST_BODY_LIMIT=1mb

# ─── Authentication (REQUIRED in production) ──────────────────────────────────
# The single operator credential for the API gateway. Generate with:
#   openssl rand -hex 32
# In production this must be at least 24 characters or the service will not start.
FACTORY_API_KEY=replace-with-a-long-random-secret

# Development-only. Permits credential-free access from 127.0.0.1 / ::1 ONLY.
# Setting this to true in production is a startup error.
ALLOW_INSECURE_LOCAL=true

# ─── Per-tenant credentials (REQUIRED for real tenant isolation) ──────────────
# FACTORY_API_KEY above is a PLATFORM OPERATOR credential: it may act for any tenant
# and every such use is recorded in the audit trail. Tenants must NOT share it.
#
# Give each tenant its own credential as a comma-separated list of tenantId:secret
# pairs. A tenant credential is bound to exactly ONE partition: presenting it with any
# other tenant id is refused with 403 TENANT_CREDENTIAL_MISMATCH. Secrets are hashed
# with salted scrypt at startup; only digests are retained afterwards.
#
#   openssl rand -hex 24          # per tenant
#   FACTORY_TENANT_CREDENTIALS=tenant_hc_1042:<secret>,tenant_log_5529:<secret>
#
# The ids must already exist as tenants. If this is unset, no tenant can authenticate
# on its own behalf and every request is a platform_operator action -- safe, but all
# access is operator access, so it should not be mistaken for tenant isolation.
# NOTE: secrets must not contain a comma; that is the pair separator.
FACTORY_TENANT_CREDENTIALS=

# ─── Filesystem boundaries (REQUIRED for the path guard) ──────────────────────
# Every repository path supplied by a caller must resolve inside this root.
# This is a hard security boundary, not a convenience default.
FACTORY_WORKSPACE_ROOT=/app/workspace

# Durable ledger, backups, previews, releases, and client workspaces.
FACTORY_DATA_DIR=.data
FACTORY_BACKUP_DIR=.data/backups
FACTORY_PREVIEW_DIR=.data/previews
FACTORY_RELEASE_DIR=.data/releases
FACTORY_CLIENT_WORKSPACE_ROOT=.data/clients
FACTORY_WORKTREE_ROOT=.data/worktrees
FACTORY_SANDBOX_ROOT=.data/sandboxes

# Optional bounds.
# FACTORY_MAX_AUDIT_ENTRIES=10000
# FACTORY_STORE_LOCK_TTL_MS=30000
# FACTORY_VERIFY_TIMEOUT_MS=120000
# FACTORY_SEED_EXAMPLES=false   # start with an empty repository-context index

# ─── Outbound model providers (fail closed) ───────────────────────────────────
# Comma-separated list of environment variable NAMES the factory may resolve and
# forward to an operator-approved model endpoint. UNSET MEANS NO SECRET MAY BE
# RESOLVED. This allowlist is what prevents a caller from exfiltrating arbitrary
# process environment variables through a model-provider baseUrl.
FACTORY_ALLOWED_SECRET_REFS=FACTORY_FRONTIER_API_KEY

# Comma-separated hostnames a remote (non-local) provider may reach. Local
# providers declared with kind "local" are exempt so on-device models work.
FACTORY_MODEL_ALLOWED_HOSTS=api.openai.com,generativelanguage.googleapis.com

# Legacy single-provider settings, kept for the appwrite-function adapter.
FACTORY_FRONTIER_API_URL=https://api.openai.com/v1
FACTORY_FRONTIER_API_KEY=replace-with-provider-secret
FACTORY_HOSTED_DEPLOYMENT_SECRET_REF=FACTORY_HOSTED_DEPLOYMENT_SECRET

# ─── Google Gemini (optional) ────────────────────────────────────────────────
# When unset, transformations use the deterministic structured fallback.
# GEMINI_API_KEY=your-gemini-api-key

# ─── Appwrite (optional, per ADR-001) ────────────────────────────────────────
# The local durable ledger is the default adapter. These are only read by the
# Appwrite serverless adapter.
# APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=your-project-id
# APPWRITE_API_KEY=your-appwrite-api-key
# APPWRITE_DATABASE_ID=software-factory
