node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
.data/

# Rust build output (2GB locally); the dependency graph is pinned in Cargo.lock
software_factory/target/

# Agent tooling installed by `npx skills add` (Appwrite SDK/CLI skills). These are local
# development aids duplicated across several agent directories, not product code: committing
# them would triple 236KB of vendored documentation into the repository and let an agent
# tool's contents become reviewable product surface. The one path that IS canonical is the
# OpenCode MCP server configuration in ~/.config/opencode/opencode.json.
.agents/
.claude/
agent/

# Built image archives. These are rebuildable from source with a single command, so committing
# 36MB binaries would bloat the history for no benefit. The digest is recorded in
# artifacts/README.md instead, which is the part that actually matters for verification.
artifacts/*.tar
artifacts/*.sha256

# --- Credential and secret material ------------------------------------------------------
#
# `.env*` above covers dotenv files. Everything below is secret material that does not live in a
# dotenv file, and each entry is here because this project actually touches it -- not speculatively.
#
# Terraform state is the important one and the most commonly forgotten. `terraform.tfstate`
# contains the *resolved values* of every variable, including the ones marked sensitive, because
# "sensitive" only hides them in CLI output. A committed state file is a plaintext secret dump.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.auto.tfvars
crash.log
crash.*.log

# Cloud provider credentials. The GCR push path in software_factory/.github/workflows/ci.yml is
# gated on secrets.GCR_PUSH, and a developer testing that locally will end up with a service
# account key file on disk. It must never be committable.
service-account*.json
*service_account*.json
gcp-credentials*.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
secrets/
secrets.*
*.secret
*.secrets
credentials.json

# Appwrite CLI session state and provider tokens.
appwrite.json
.appwrite/

# Cloudflare / Vercel / Netlify local credential caches.
.dev.vars
.vercel/
.netlify/

# Terraform plan output can contain secrets in cleartext.
*.tfplan
